from __future__ import annotations

import datetime as dt
import time
from typing import Dict, Iterable, Optional
from urllib.parse import urlencode

import pandas as pd
import requests
from rapidfuzz import fuzz

from .utils import normalize_isbn, normalize_text

CINII_BOOKS_ENDPOINT = "https://ci.nii.ac.jp/books/opensearch/search"
DEFAULT_TSUKUBA_KID = "KI000174"


def build_cinii_params(ref: Dict[str, object], appid: str, kid: str = DEFAULT_TSUKUBA_KID, fano: str = "") -> Dict[str, str]:
    isbn = normalize_isbn(ref.get("isbn", ""))
    params: Dict[str, str] = {
        "appid": appid,
        "format": "json",
        "count": "5",
        "type": "1",  # books
    }
    if kid:
        params["kid"] = kid
    if fano:
        params["fano"] = fano
    if isbn:
        params["isbn"] = isbn
    else:
        title = str(ref.get("title", "") or ref.get("source_text", "") or "").strip()
        author = str(ref.get("author", "") or "").strip()
        if title:
            params["title"] = title[:120]
        if author:
            params["author"] = author[:80]
        if not title and not author:
            params["q"] = str(ref.get("source_text", ""))[:120]
    return params


def cinii_search_url(ref: Dict[str, object], kid: str = DEFAULT_TSUKUBA_KID, fano: str = "") -> str:
    params = build_cinii_params(ref, appid="", kid=kid, fano=fano)
    params.pop("appid", None)
    params["format"] = "html"
    return f"{CINII_BOOKS_ENDPOINT}?{urlencode(params)}"


def _items_from_jsonld(data: Dict) -> list[Dict]:
    graph = data.get("@graph") or []
    if not graph:
        return []
    channel = graph[0] if isinstance(graph[0], dict) else {}
    items = channel.get("items") or []
    if isinstance(items, dict):
        return [items]
    return items if isinstance(items, list) else []


def _string_value(value) -> str:
    if value is None:
        return ""
    if isinstance(value, str):
        return value
    if isinstance(value, list):
        vals = [_string_value(v) for v in value]
        return "; ".join(v for v in vals if v)
    if isinstance(value, dict):
        return str(value.get("@value") or value.get("@id") or value.get("dc:title") or "")
    return str(value)


def _best_item_score(ref: Dict[str, object], item: Dict) -> int:
    if normalize_isbn(ref.get("isbn", "")):
        return 100
    ref_title = normalize_text(ref.get("title", ""))
    item_title = normalize_text(item.get("title", ""))
    if not ref_title or not item_title:
        return 0
    return int(fuzz.token_set_ratio(ref_title, item_title))


def lookup_one_reference(
    ref: Dict[str, object],
    appid: str,
    kid: str = DEFAULT_TSUKUBA_KID,
    fano: str = "",
    timeout: float = 12.0,
) -> Dict[str, object]:
    material_type = str(ref.get("material_type", ""))
    if material_type in {"配付資料", "Web資料"}:
        return {
            "canonical_key": ref.get("canonical_key", ""),
            "isbn": normalize_isbn(ref.get("isbn", "")),
            "holding_status": "対象外",
            "holding_confidence": "-",
            "cinii_title": "",
            "cinii_url": "",
            "opac_url": "",
            "owner_count": "",
            "checked_at": dt.datetime.now().isoformat(timespec="seconds"),
            "notes": "配付資料・Web資料のため図書館所蔵照合の対象外",
        }
    if not appid:
        return {
            "canonical_key": ref.get("canonical_key", ""),
            "isbn": normalize_isbn(ref.get("isbn", "")),
            "holding_status": "未照合",
            "holding_confidence": "-",
            "cinii_title": "",
            "cinii_url": cinii_search_url(ref, kid=kid, fano=fano),
            "opac_url": "",
            "owner_count": "",
            "checked_at": "",
            "notes": "CiNiiアプリケーションID未設定。検索リンクのみ生成。",
        }

    params = build_cinii_params(ref, appid=appid, kid=kid, fano=fano)
    try:
        response = requests.get(CINII_BOOKS_ENDPOINT, params=params, timeout=timeout)
        response.raise_for_status()
        data = response.json()
    except Exception as exc:  # noqa: BLE001 - UI should display API errors gracefully.
        return {
            "canonical_key": ref.get("canonical_key", ""),
            "isbn": normalize_isbn(ref.get("isbn", "")),
            "holding_status": "照合エラー",
            "holding_confidence": "-",
            "cinii_title": "",
            "cinii_url": cinii_search_url(ref, kid=kid, fano=fano),
            "opac_url": "",
            "owner_count": "",
            "checked_at": dt.datetime.now().isoformat(timespec="seconds"),
            "notes": str(exc),
        }

    items = _items_from_jsonld(data)
    if not items:
        return {
            "canonical_key": ref.get("canonical_key", ""),
            "isbn": normalize_isbn(ref.get("isbn", "")),
            "holding_status": "所蔵なし候補",
            "holding_confidence": "中",
            "cinii_title": "",
            "cinii_url": cinii_search_url(ref, kid=kid, fano=fano),
            "opac_url": "",
            "owner_count": "0",
            "checked_at": dt.datetime.now().isoformat(timespec="seconds"),
            "notes": "指定した筑波大学機関/図書館IDでは候補なし",
        }

    best = max(items, key=lambda item: _best_item_score(ref, item))
    score = _best_item_score(ref, best)
    status = "所蔵あり" if score >= 80 or normalize_isbn(ref.get("isbn", "")) else "所蔵候補あり"
    confidence = "高" if status == "所蔵あり" and (normalize_isbn(ref.get("isbn", "")) or score >= 90) else "要確認"
    link = best.get("link")
    cinii_url = link.get("@id") if isinstance(link, dict) else _string_value(link)
    return {
        "canonical_key": ref.get("canonical_key", ""),
        "isbn": normalize_isbn(ref.get("isbn", "")),
        "holding_status": status,
        "holding_confidence": confidence,
        "cinii_title": _string_value(best.get("title")),
        "cinii_url": cinii_url,
        "opac_url": cinii_url,
        "owner_count": _string_value(best.get("cinii:ownerCount")),
        "checked_at": dt.datetime.now().isoformat(timespec="seconds"),
        "notes": f"title_similarity={score}",
    }


def lookup_references(
    refs: pd.DataFrame,
    appid: str = "",
    kid: str = DEFAULT_TSUKUBA_KID,
    fano: str = "",
    limit: Optional[int] = None,
    sleep_seconds: float = 0.25,
) -> pd.DataFrame:
    if refs.empty:
        return pd.DataFrame()
    unique = refs.drop_duplicates("canonical_key").copy()
    if limit is not None:
        unique = unique.head(limit)
    results = []
    for _, row in unique.iterrows():
        results.append(lookup_one_reference(row.to_dict(), appid=appid, kid=kid, fano=fano))
        if appid and sleep_seconds:
            time.sleep(sleep_seconds)
    return pd.DataFrame(results)


def merge_holdings(refs: pd.DataFrame, holdings: pd.DataFrame) -> pd.DataFrame:
    if refs.empty:
        return refs
    if holdings is None or holdings.empty or "canonical_key" not in holdings.columns:
        out = refs.copy()
        out["holding_status"] = out["material_type"].map(lambda x: "対象外" if x in {"配付資料", "Web資料"} else "未照合")
        out["holding_confidence"] = "-"
        out["cinii_url"] = out.apply(lambda r: cinii_search_url(r.to_dict()), axis=1)
        return out
    cols = [c for c in holdings.columns if c != "isbn"]
    return refs.merge(holdings[cols], on="canonical_key", how="left")
